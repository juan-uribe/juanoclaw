# NanoClaw environment variables
# Copy this file to .env and fill in the values.
# Location: project root (nanoclaw-sandbox-4898/.env)
#
# Per-group secrets (API keys, tokens used inside agent containers) go in:
#   ~/.config/nanoclaw/secrets/<group-folder>.env
# They are never stored here.

# =============================================================================
# REQUIRED
# =============================================================================

# Your WhatsApp phone number (digits only, with country code, no + or spaces).
# Used to auto-register your personal DM as the main channel.
# Example: 523314465615
WA_OWNER_NUMBER=

# OneCLI gateway URL — manages Anthropic credentials for agent containers.
# Set automatically by the OneCLI installer. Default: http://localhost:10254
ONECLI_URL=

# GitHub Personal Access Token — used by backup.sh to push to your repos.
# Needs write access to CODE_REPO and BACKUP_REPO below.
GITHUB_TOKEN=

# GitHub repo for code backup (username/repo-name). Defaults to current git remote.
# Example: juan-uribe/nanoclaw
CODE_REPO=

# GitHub repo for data backup (DB, sessions, agent memory). Must be private.
# Example: juan-uribe/nanoclaw-backup
# Leave blank to skip data backup.
BACKUP_REPO=

# =============================================================================
# CHANNELS
# =============================================================================

# Telegram bot token — from @BotFather. Required if Telegram channel is enabled.
TELEGRAM_BOT_TOKEN=

# =============================================================================
# IDENTITY  (optional — defaults shown)
# =============================================================================

# The assistant's name. Used as the trigger word (@AssistantName).
# Default: Andy
ASSISTANT_NAME=

# Set to "true" if the WhatsApp account is a dedicated bot number
# (not your personal phone). Affects some WA messaging behavior.
# Default: false
ASSISTANT_HAS_OWN_NUMBER=

# Timezone for scheduling and log timestamps.
# Use a tz database name: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Example: America/Mexico_City
# Default: auto-detected from system
TZ=

# =============================================================================
# TUNING  (optional — defaults shown)
# =============================================================================

# Port for the internal credential proxy (containers route API calls through this).
# Default: 3001
CREDENTIAL_PROXY_PORT=

# Max time (ms) an agent container can run before being killed.
# Default: 1800000 (30 minutes)
CONTAINER_TIMEOUT=

# How long (ms) to keep a container alive after its last output before closing stdin.
# Default: 1800000 (30 minutes)
IDLE_TIMEOUT=

# Max number of agent containers running at the same time.
# Default: 5
MAX_CONCURRENT_CONTAINERS=

# Max messages to include in a single agent prompt.
# Default: 10
MAX_MESSAGES_PER_PROMPT=

# Log level: trace | debug | info | warn | error
# Default: info
LOG_LEVEL=

# =============================================================================
# ADVANCED  (leave blank unless you know you need these)
# =============================================================================

# Custom container image name (if you rebuilt with a different tag).
# Default: nanoclaw-agent:latest
CONTAINER_IMAGE=

# Max agent output size in bytes before truncation.
# Default: 10485760 (10 MB)
CONTAINER_MAX_OUTPUT_SIZE=

# HTTP/HTTPS proxy for outbound requests (corporate networks, etc.)
HTTP_PROXY=
HTTPS_PROXY=

# Custom SSL certificate file path (self-signed certs, corporate CAs, etc.)
SSL_CERT_FILE=

# Override the credential proxy host as seen from inside containers.
# Default: host.docker.internal
CREDENTIAL_PROXY_HOST=
